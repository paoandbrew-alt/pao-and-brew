.muted { font-size: 11px; color: rgb(107, 114, 128); }

a.wa { display: block; text-align: center; background: rgb(31, 168, 85); color: rgb(255, 255, 255); padding: 12px; border-radius: 12px; font-weight: 900; text-decoration: none; margin-top: 8px; font-size: 13px; }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: 80px; background: rgb(15, 61, 46); color: rgb(255, 255, 255); padding: 10px 14px; border-radius: 999px; font-size: 12px; font-weight: 800; z-index: 99; display: none; }

.modal { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.55); display: none; align-items: flex-end; justify-content: center; z-index: 50; }

.modal.open { display: flex; }

.sheet { background: rgb(255, 255, 255); width: 100%; max-width: 520px; border-radius: 20px 20px 0px 0px; padding: 16px; max-height: 88vh; overflow: auto; }
